<!--
  TreatAsLocalProperty: IDEs such as Rider pass their own JavaSdkDirectory to MSBuild (an old or placeholder Java
  when none is configured, giving XA0031 "Java SDK 11.0 or above is required"). This lets Local.props override it.
-->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="JavaSdkDirectory">

  <!-- Machine-specific settings that stay out of git: GoogleMapsApiKey, optionally JavaSdkDirectory. See Local.props.example. -->
  <Import Project="Local.props" Condition="Exists('Local.props')" />

  <PropertyGroup>
    <!--
      Each app target is built only where its tools exist, so the solution still builds anywhere:
      net10.0-ios needs a Mac with Xcode; net10.0-android needs the Android SDK and a JDK (set EnableAndroid=false to
      skip it). The plain net10.0 target always compiles all the C# and XAML so mistakes surface early.
    -->
    <_HasXcode Condition="$([MSBuild]::IsOSPlatform('osx')) And Exists('/Applications/Xcode.app')">true</_HasXcode>
    <_HasAndroidSdk Condition="'$(AndroidSdkDirectory)' != '' Or '$(ANDROID_HOME)' != '' Or Exists('$(HOME)/Library/Android/sdk')">true</_HasAndroidSdk>
    <_HasJdk Condition="'$(JavaSdkDirectory)' != '' Or '$(JAVA_HOME)' != '' Or Exists('/Library/Java/JavaVirtualMachines/microsoft-21.jdk')">true</_HasJdk>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(EnableAndroid)' != 'false' And '$(_HasAndroidSdk)' == 'true' And '$(_HasJdk)' == 'true'">net10.0-android;$(TargetFrameworks)</TargetFrameworks>
    <TargetFrameworks Condition="'$(_HasXcode)' == 'true'">net10.0-ios;$(TargetFrameworks)</TargetFrameworks>
    <OutputType Condition="'$(TargetFramework)' != 'net10.0'">Exe</OutputType>

    <RootNamespace>PhotoWorld.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

    <ApplicationTitle>PhotoWorld</ApplicationTitle>
    <!-- Change to your own reverse-DNS id before signing with your Apple developer account. -->
    <ApplicationId>com.photoworld.app</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">16.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>

    <!-- Fills ${GoogleMapsApiKey} in Platforms/Android/AndroidManifest.xml. Empty: the Places map stays blank. -->
    <AndroidManifestPlaceholders>GoogleMapsApiKey=$(GoogleMapsApiKey)</AndroidManifestPlaceholders>
  </PropertyGroup>

  <!--
    .NET for iOS insists on the exact Xcode it was built with (27.0 today) and refuses newer minor versions such as
    Xcode 27.1, which builds and runs this app fine. Remove once a .NET for iOS release for your Xcode is installed.
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0E0F12" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFFFFF" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Controls.Maps" Version="$(MauiVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

  <!--
    The API's DTOs, routes and limits, compiled straight from PhotoWorld.Shared so the app and the servers can't
    drift apart. Not a project reference: Shared also carries the Supabase logger (Npgsql), which an app mustn't ship.
  -->
  <ItemGroup>
    <Compile Include="..\PhotoWorld.Shared\**\*.cs" Exclude="..\PhotoWorld.Shared\Logging\**;..\PhotoWorld.Shared\bin\**;..\PhotoWorld.Shared\obj\**"
             LinkBase="Shared" />
  </ItemGroup>

</Project>
