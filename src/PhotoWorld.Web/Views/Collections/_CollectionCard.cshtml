@model CollectionSummaryDto
<article class="post-card collection-card">
    <a asp-controller="Collections" asp-action="Details" asp-route-id="@Model.Id" class="post-card-cover" tabindex="-1" aria-hidden="true">
        @if (Model.CoverUrl is not null)
        {
            <img src="@Model.CoverUrl" alt="" loading="lazy" />
        }
        else
        {
            <span class="post-card-cover-empty"></span>
        }
        @if (Model.IsMine && !Model.IsPublic)
        {
            <span class="moderation-badge photo-card-badge draft-badge">Private</span>
        }
    </a>
    <div class="post-card-body">
        <h3><a asp-controller="Collections" asp-action="Details" asp-route-id="@Model.Id">@Model.Title</a></h3>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="post-card-excerpt">@Model.Description</p>
        }
        <div class="post-card-meta">
            <span>@Model.PhotoCount @(Model.PhotoCount == 1 ? "photo" : "photos")</span>
            <span>@Model.UpdatedAt.ToString("d MMM yyyy")</span>
        </div>
    </div>
</article>
