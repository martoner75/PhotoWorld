<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PhotoWorld.App.ViewModels"
             x:Class="PhotoWorld.App.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Me">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="18" Spacing="14" MaximumWidthRequest="560">
                <HorizontalStackLayout Spacing="14">
                    <Border WidthRequest="64" HeightRequest="64" StrokeShape="RoundRectangle 32" Padding="0" StrokeThickness="0">
                        <Image Source="{Binding User.AvatarUrl}" Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="{Binding User.DisplayName}" Style="{StaticResource Subheading}" />
                        <Label Text="{Binding User.Email}" Style="{StaticResource MutedText}" />
                        <Label Text="{Binding MemberSince}" Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Border Padding="4">
                    <VerticalStackLayout>
                        <Button Text="My member page" Style="{StaticResource LinkButton}" HorizontalOptions="Start"
                                Command="{Binding OpenMyPageCommand}" />
                        <Button Text="Photo challenges" Style="{StaticResource LinkButton}" HorizontalOptions="Start"
                                Command="{Binding OpenChallengesCommand}" />
                        <Button Text="Open PhotoWorld on the web" Style="{StaticResource LinkButton}" HorizontalOptions="Start"
                                Command="{Binding OpenWebsiteCommand}" />
                        <Button Text="Privacy policy" Style="{StaticResource LinkButton}" HorizontalOptions="Start"
                                Command="{Binding OpenPrivacyCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Email notifications" Style="{StaticResource Subheading}" />
                        <Label Text="Get an email when members publish new blog posts." Style="{StaticResource MutedText}" FontSize="14" />
                        <Label Text="{Binding NotifyStatus}" FontSize="14" />
                        <Button Text="Send the confirmation link again" Style="{StaticResource LinkButton}" HorizontalOptions="Start"
                                Command="{Binding ResendConfirmationCommand}" IsVisible="{Binding AwaitingConfirmation}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Email me about new blog posts" Style="{StaticResource Strong}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding NotifyEnabled}" />
                        </Grid>
                        <Label Text="Send them to" Style="{StaticResource Strong}" />
                        <Border Style="{StaticResource Field}">
                            <Entry Text="{Binding NotifyEmail}" Keyboard="Email" Placeholder="you@example.com" />
                        </Border>
                        <Label Text="Any address you like. If it isn't your Google email, we'll send a confirmation link first."
                               Style="{StaticResource MutedText}" />
                        <Label Text="How often" Style="{StaticResource Strong}" />
                        <Border Style="{StaticResource Field}">
                            <Picker ItemsSource="{Binding FrequencyOptions}" SelectedIndex="{Binding FrequencyIndex}"
                                    TextColor="{StaticResource Text}" Title="How often" />
                        </Border>
                        <Button Text="Save notification settings" Command="{Binding SaveNotificationsCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Sign out" Command="{Binding SignOutCommand}" Style="{StaticResource GhostButton}" />

                <Border Padding="16" Stroke="#6B2A2A" Margin="0,18,0,0">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Delete account" Style="{StaticResource Subheading}" />
                        <Label Text="Permanently deletes your account, all your photos, your blog, your places, notification settings, likes and comments, straight away. This can't be undone."
                               Style="{StaticResource MutedText}" FontSize="14" />
                        <Button Text="Delete my account" Command="{Binding DeleteAccountCommand}" Style="{StaticResource DangerButton}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center" />
    </Grid>
</ContentPage>
