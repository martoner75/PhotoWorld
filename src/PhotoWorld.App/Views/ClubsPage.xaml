<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PhotoWorld.App.ViewModels"
             x:Class="PhotoWorld.App.Views.ClubsPage"
             x:DataType="vm:ClubsViewModel"
             Title="Camera clubs">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Start a club" Command="{Binding NewCommand}" />
    </ContentPage.ToolbarItems>
    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <CollectionView ItemsSource="{Binding Items}" SelectionMode="None" Margin="12,8">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.Header>
                <VerticalStackLayout Spacing="8" Padding="0,0,0,8">
                    <Label Text="Local clubs run by members. Join one to meet photographers near you."
                           Style="{StaticResource MutedText}" FontSize="14" />
                    <Border Padding="3" StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="3">
                            <Button Text="Directory" Style="{StaticResource SegmentButton}" Command="{Binding ShowCommand}" CommandParameter="all">
                                <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Mine}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Line}" /><Setter Property="TextColor" Value="{DynamicResource Text}" />
                                </DataTrigger></Button.Triggers>
                            </Button>
                            <Button Grid.Column="1" Text="My clubs" Style="{StaticResource SegmentButton}" Command="{Binding ShowCommand}" CommandParameter="mine">
                                <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Mine}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Line}" /><Setter Property="TextColor" Value="{DynamicResource Text}" />
                                </DataTrigger></Button.Triggers>
                            </Button>
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <SearchBar Text="{Binding SearchText}" Placeholder="Club name or city" SearchCommand="{Binding SearchCommand}" />
                        <Button Grid.Column="1" Text="📍 Near me" Style="{StaticResource GhostButton}" Padding="12,6"
                                Command="{Binding NearMeCommand}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <Label Text="{Binding EmptyMessage}" Style="{StaticResource MutedText}" FontSize="15" HorizontalTextAlignment="Center"
                       Margin="32,60" IsVisible="{Binding IsEmpty}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ClubItem">
                    <Border Padding="14,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer CommandParameter="{Binding .}"
                                Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:ClubsViewModel}}, x:DataType=vm:ClubsViewModel}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                            <!-- The club's cover (its chosen or newest shared photo), or its initial. -->
                            <Border Grid.RowSpan="2" WidthRequest="56" HeightRequest="56" Padding="0" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10" BackgroundColor="{DynamicResource PhotoBackground}" VerticalOptions="Center">
                                <Grid>
                                    <Label Text="{Binding Initial}" FontSize="24" FontAttributes="Bold" TextColor="{DynamicResource Accent}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Image Source="{Binding Club.CoverUrl}" Aspect="AspectFill"
                                           IsVisible="{Binding Club.CoverUrl, Converter={StaticResource HasValue}}" />
                                </Grid>
                            </Border>
                            <Label Grid.Column="1" Text="{Binding Club.Name}" Style="{StaticResource Subheading}" FontSize="18" />
                            <Label Grid.Column="2" Text="{Binding Badge}" Style="{StaticResource MutedText}" VerticalOptions="Center"
                                   IsVisible="{Binding Badge, Converter={StaticResource HasValue}}" />
                            <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Facts}" Style="{StaticResource MutedText}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
