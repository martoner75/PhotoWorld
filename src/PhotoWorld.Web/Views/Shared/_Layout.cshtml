<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · PhotoWorld</title>
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" />
    @* Light, dark or automatic (follow the device), remembered in this browser. Runs before the page paints, so there's
       no flash of the wrong colours. site.css and Bootstrap's own components both read the attributes set here. *@
    <script>
        (() => {
            // The theme choice lives in localStorage only if the visitor accepted preference storage (Cookie
            // settings); otherwise in sessionStorage, which the browser clears when it closes.
            const dark = matchMedia("(prefers-color-scheme: dark)");
            const store = () => /(?:^|; )PhotoWorld\.Consent=preferences(?:;|$)/.test(document.cookie) ? localStorage : sessionStorage;
            const apply = () => {
                let choice = "auto";
                try { choice = store().getItem("pw-theme") || "auto"; } catch { }
                const theme = choice === "light" || choice === "dark" ? choice : dark.matches ? "dark" : "light";
                const root = document.documentElement;
                root.dataset.theme = root.dataset.bsTheme = theme;
                root.dataset.themeChoice = choice;
                document.querySelector('meta[name="theme-color"]')?.setAttribute("content", theme === "dark" ? "#1e2127" : "#ffffff");
            };
            window.pwSetTheme = (choice) => {
                try { choice === "auto" ? store().removeItem("pw-theme") : store().setItem("pw-theme", choice); } catch { }
                apply();
            };
            // Consent changed: carry the current choice over to the right storage and clear the other one.
            window.pwMoveTheme = () => {
                try {
                    const choice = localStorage.getItem("pw-theme") || sessionStorage.getItem("pw-theme");
                    localStorage.removeItem("pw-theme"); sessionStorage.removeItem("pw-theme");
                    if (choice) store().setItem("pw-theme", choice);
                } catch { }
            };
            apply();
            dark.addEventListener("change", apply);
        })();
    </script>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Inter:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @await RenderSectionAsync("Head", required: false)
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm site-nav">
            <div class="container">
                <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true"></span> PhotoWorld
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav align-items-sm-center gap-sm-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var avatar = User.FindFirstValue(PhotoWorldClaimTypes.AvatarUrl);
                            <li class="nav-item"><a class="nav-link" asp-controller="Photos" asp-action="Index">Gallery</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Search" asp-action="Explore">Explore</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Blogs" asp-action="Index">Blogs</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Challenges" asp-action="Index">Challenges</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Walks" asp-action="Index">Walks</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Places" asp-action="Index">My places</a></li>
                            @if (User.HasClaim(PhotoWorldClaimTypes.IsAdmin, "true"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Users">Admin</a></li>
                            }
                            <li class="nav-item">
                                <form asp-controller="Search" asp-action="Index" method="get" class="nav-search" role="search">
                                    <input name="q" maxlength="100" placeholder="Search" aria-label="Search PhotoWorld" />
                                </form>
                            </li>
                            <partial name="_ThemeToggle" />
                            <li class="nav-item">
                                <a class="nav-link nav-bell" asp-controller="Activity" asp-action="Index" aria-label="Activity" data-activity-bell>
                                    <svg class="nav-bell-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"
                                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M3.5 13.5h4.2l1.6 2.5h5.4l1.6-2.5h4.2" /><path d="M5.6 5.5h12.8l2.1 8v4.5a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2v-4.5Z" />
                                    </svg><span class="nav-bell-count" data-activity-count hidden></span>
                                </a>
                            </li>
                            <li class="nav-item"><a class="btn btn-accent btn-sm" asp-controller="Photos" asp-action="Upload">Upload</a></li>
                            <li class="nav-item">
                                <a class="nav-link nav-user" asp-controller="Members" asp-action="Me">
                                    @if (avatar is not null)
                                    {
                                        <img src="@avatar" alt="" referrerpolicy="no-referrer" />
                                    }
                                    @User.Identity.Name
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-ghost btn-sm">Sign out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <partial name="_ThemeToggle" />
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a></li>
                            <li class="nav-item"><a class="btn btn-accent btn-sm" asp-controller="Account" asp-action="Register">Join</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["Flash"] is string flash)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show" role="status">
                @flash
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            &copy; @DateTime.Now.Year PhotoWorld · <a asp-controller="Home" asp-action="Terms">Terms</a> · <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            · <button type="button" class="link-button" data-cookie-settings>Cookie settings</button>
        </div>
    </footer>
    <partial name="_CookieBanner" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
