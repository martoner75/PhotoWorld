@model PagedResult<PhotoSummaryDto>
@{
    ViewData["Title"] = "Gallery";
}

<section class="container page">
    <header class="page-header">
        <div>
            <h1>Gallery</h1>
            <p class="text-muted">The latest shots from PhotoWorld members.</p>
        </div>
        <a class="btn btn-accent" asp-action="Upload">Upload a photo</a>
    </header>

    @if (Model.TotalCount == 0)
    {
        <div class="empty-state">
            <p>No photos yet. Be the first to share one!</p>
            <a class="btn btn-accent" asp-action="Upload">Upload a photo</a>
        </div>
    }
    else
    {
        <partial name="_PhotoGrid" model="Model" />
    }
</section>
