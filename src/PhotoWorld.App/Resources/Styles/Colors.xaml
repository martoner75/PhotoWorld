<?xml version="1.0" encoding="UTF-8" ?>
<!--
    PhotoWorld's palette, matching the website: Gallery White, or Graphite when the device is in dark mode.
    These are the light values; ThemePalette swaps in the dark ones (pages use DynamicResource, so they follow).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Color x:Key="Ink">#FFFFFF</Color>
    <Color x:Key="Ink2">#FAFAF8</Color>
    <Color x:Key="Line">#E5E3DE</Color>
    <Color x:Key="Text">#17181B</Color>
    <Color x:Key="Muted">#6B6F78</Color>
    <Color x:Key="Accent">#C96F14</Color>
    <Color x:Key="AccentInk">#FFFFFF</Color>
    <Color x:Key="AccentSoft">#FBF1E4</Color>
    <Color x:Key="AccentLine">#ECC89E</Color>
    <Color x:Key="Danger">#B3261E</Color>
    <Color x:Key="DangerSoft">#FBECEB</Color>
    <Color x:Key="DangerLine">#E9B8B4</Color>
    <Color x:Key="PhotoBackground">#F1F0ED</Color>
    <Color x:Key="Scrim">#E0FFFFFF</Color>
</ResourceDictionary>
