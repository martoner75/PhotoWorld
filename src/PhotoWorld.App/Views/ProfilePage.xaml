<?xml version="1.0" encoding="utf-8" ?>
<!-- The Me tab: the member's own things, the same list as the website's avatar menu. Settings has its own screen. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:PhotoWorld.App.Views"
             xmlns:vm="clr-namespace:PhotoWorld.App.ViewModels"
             x:Class="PhotoWorld.App.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Me">
    <ContentPage.ToolbarItems>
        <views:ThemeToolbarItem />
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="18" Spacing="14" MaximumWidthRequest="560">
                <HorizontalStackLayout Spacing="14">
                    <Border WidthRequest="64" HeightRequest="64" StrokeShape="RoundRectangle 32" Padding="0" StrokeThickness="0">
                        <Image Source="{Binding User.AvatarUrl}" Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="{Binding User.DisplayName}" Style="{StaticResource Subheading}" />
                        <Label Text="{Binding User.Email}" Style="{StaticResource MutedText}" />
                        <Label Text="{Binding MemberSince}" Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Border Padding="4">
                    <VerticalStackLayout>
                        <Button Text="Activity" Style="{StaticResource LinkButton}" HorizontalOptions="Start"
                                Command="{Binding OpenActivityCommand}" />
                        <Button Text="My member page" Style="{StaticResource LinkButton}" HorizontalOptions="Start"
                                Command="{Binding OpenMyPageCommand}" />
                        <Button Text="My collections" Style="{StaticResource LinkButton}" HorizontalOptions="Start"
                                Command="{Binding OpenCollectionsCommand}" />
                        <Button Text="My clubs" Style="{StaticResource LinkButton}" HorizontalOptions="Start"
                                Command="{Binding OpenClubsCommand}" />
                        <Button Text="My portfolio" Style="{StaticResource LinkButton}" HorizontalOptions="Start"
                                Command="{Binding OpenPortfolioCommand}" />
                        <Button Text="Insights" Style="{StaticResource LinkButton}" HorizontalOptions="Start"
                                Command="{Binding OpenInsightsCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="4">
                    <VerticalStackLayout>
                        <Button Text="Settings" Style="{StaticResource LinkButton}" HorizontalOptions="Start"
                                Command="{Binding OpenSettingsCommand}" />
                        <Label Text="Appearance, activity, email notifications, blocked members and your account."
                               Style="{StaticResource MutedText}" FontSize="13" Margin="12,0,12,8" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="4">
                    <VerticalStackLayout>
                        <Button Text="Open PhotoWorld on the web" Style="{StaticResource LinkButton}" HorizontalOptions="Start"
                                Command="{Binding OpenWebsiteCommand}" />
                        <Button Text="Terms of use" Style="{StaticResource LinkButton}" HorizontalOptions="Start"
                                Command="{Binding OpenTermsCommand}" />
                        <Button Text="Privacy policy" Style="{StaticResource LinkButton}" HorizontalOptions="Start"
                                Command="{Binding OpenPrivacyCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Sign out" Command="{Binding SignOutCommand}" Style="{StaticResource GhostButton}" />
            </VerticalStackLayout>
        </ScrollView>
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center" />
    </Grid>
</ContentPage>
