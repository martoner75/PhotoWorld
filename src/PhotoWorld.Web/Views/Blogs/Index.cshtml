@model BlogsIndexViewModel
@{
    ViewData["Title"] = "Blogs";
}

<section class="container page">
    <header class="page-header">
        <div>
            <h1>Blogs</h1>
            <p class="text-muted">Stories behind the shots, from PhotoCommunity members.</p>
        </div>
        <div class="member-actions">
            <a class="btn btn-ghost" asp-action="Mine">My blog</a>
            <a class="btn btn-accent" asp-action="New">Write a post</a>
        </div>
    </header>

    <partial name="_FeedTabs" model="new FeedTabsViewModel(Model.Following)" />

    @if (Model.Posts.TotalCount == 0 && Model.Following)
    {
        <div class="empty-state">
            <p>No posts from members you follow yet. Follow members from their page to see their posts here.</p>
            <a class="btn btn-ghost" asp-action="Index">See everyone's posts</a>
        </div>
    }
    else if (Model.Posts.TotalCount == 0)
    {
        <div class="empty-state">
            <p>No posts yet. Tell the story behind one of your photos!</p>
            <a class="btn btn-accent" asp-action="New">Write the first post</a>
        </div>
    }
    else
    {
        <partial name="_PostGrid" model="Model.Posts" />
    }
</section>
