<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PhotoWorld.App.ViewModels"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             x:Class="PhotoWorld.App.Views.PlacesPage"
             x:DataType="vm:PlacesViewModel"
             Title="My places">
    <!-- Phone: map above the list. iPad (wide): list beside the map. Rows/columns are set in code-behind. -->
    <Grid x:Name="Root" RowDefinitions="Auto,*,*" ColumnDefinitions="*">
        <SearchBar Grid.Row="0" Text="{Binding SearchText}" Placeholder="Find a city, landmark or address"
                   SearchCommand="{Binding SearchCommand}" Margin="6,2" />

        <maps:Map x:Name="Map" Grid.Row="1" MapType="Street" IsShowingUser="False" MapClicked="OnMapClicked"
                  ItemsSource="{Binding Places}">
            <maps:Map.ItemTemplate>
                <DataTemplate x:DataType="vm:PlaceItem">
                    <maps:Pin Location="{Binding Location}" Label="{Binding Name}" Address="{Binding Subtitle}"
                              Type="Place" InfoWindowClicked="OnPinInfoClicked" />
                </DataTemplate>
            </maps:Map.ItemTemplate>
        </maps:Map>

        <CollectionView x:Name="List" Grid.Row="2" ItemsSource="{Binding Places}" SelectionMode="None">
            <CollectionView.Header>
                <Label Text="Only you can see your places. Tap the map or search to add one."
                       Style="{StaticResource MutedText}" Margin="16,12,16,4" />
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <Label Text="No places yet." Style="{StaticResource MutedText}" Margin="16,8" IsVisible="{Binding IsEmpty}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:PlaceItem">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Edit" BackgroundColor="{StaticResource Line}"
                                           Command="{Binding EditCommand, Source={RelativeSource AncestorType={x:Type vm:PlacesViewModel}}, x:DataType=vm:PlacesViewModel}"
                                           CommandParameter="{Binding .}" />
                                <SwipeItem Text="Remove" BackgroundColor="#8A3A3A" IsDestructive="True"
                                           Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type vm:PlacesViewModel}}, x:DataType=vm:PlacesViewModel}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Grid Padding="16,10" ColumnDefinitions="*,Auto" BackgroundColor="{StaticResource Ink}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowCommand, Source={RelativeSource AncestorType={x:Type vm:PlacesViewModel}}, x:DataType=vm:PlacesViewModel}"
                                                      CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Spacing="1">
                                <Label Text="{Binding Name}" Style="{StaticResource Strong}" />
                                <Label Text="{Binding Subtitle}" Style="{StaticResource MutedText}"
                                       IsVisible="{Binding Subtitle, Converter={StaticResource HasValue}}" />
                                <Label Text="{Binding Note}" Style="{StaticResource MutedText}" MaxLines="2" LineBreakMode="TailTruncation"
                                       IsVisible="{Binding Note, Converter={StaticResource HasValue}}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Edit" Style="{StaticResource LinkButton}" VerticalOptions="Center"
                                    Command="{Binding EditCommand, Source={RelativeSource AncestorType={x:Type vm:PlacesViewModel}}, x:DataType=vm:PlacesViewModel}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.RowSpan="3" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           VerticalOptions="Center" HorizontalOptions="Center" />
    </Grid>
</ContentPage>
