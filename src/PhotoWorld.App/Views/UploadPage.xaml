<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:PhotoWorld.App.Views"
             xmlns:vm="clr-namespace:PhotoWorld.App.ViewModels"
             x:Class="PhotoWorld.App.Views.UploadPage"
             x:DataType="vm:UploadViewModel"
             Title="Upload">
    <ContentPage.ToolbarItems>
        <views:ThemeToolbarItem />
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="18" Spacing="14" MaximumWidthRequest="640">
                <!-- Step 1: choose a photo (or several: then each gets a title in the list below). -->
                <Border IsVisible="{Binding IsSingle}" Padding="0" HeightRequest="{OnIdiom Phone=280, Tablet=420, Default=360}" BackgroundColor="{DynamicResource PhotoBackground}">
                    <Grid>
                        <Image Source="{Binding Preview}" Aspect="AspectFit" IsVisible="{Binding HasPhoto}" />
                        <VerticalStackLayout VerticalOptions="Center" Spacing="12" Padding="24" IsVisible="{Binding HasPhoto, Converter={StaticResource Not}}">
                            <Label Text="Share a photo" Style="{StaticResource Subheading}" HorizontalTextAlignment="Center" />
                            <Label Text="JPEG, PNG, WebP or iPhone HEIC, up to 25 MB. Location data is removed before it's stored."
                                   Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="Choose photos" Command="{Binding PickCommand}" Style="{StaticResource GhostButton}" />
                    <Button Grid.Column="1" Text="Take a photo" Command="{Binding TakeCommand}" Style="{StaticResource GhostButton}"
                            IsEnabled="{Binding CanTakePhoto}" />
                </Grid>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Batch}" Spacing="8" IsVisible="{Binding IsBatch}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:UploadItem">
                            <Border Padding="8">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border WidthRequest="72" HeightRequest="72" StrokeShape="RoundRectangle 8" Padding="0" StrokeThickness="0"
                                            BackgroundColor="{DynamicResource PhotoBackground}">
                                        <Image Source="{Binding Preview}" Aspect="AspectFill" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Border Style="{StaticResource Field}">
                                            <Entry Text="{Binding Title}" Placeholder="Title" MaxLength="120" />
                                        </Border>
                                        <Label Text="{Binding Status}" Style="{StaticResource MutedText}"
                                               IsVisible="{Binding Status, Converter={StaticResource HasValue}}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="Tags, place and the options below apply to all of these photos." Style="{StaticResource MutedText}"
                       IsVisible="{Binding IsBatch}" />

                <!-- Step 2: describe it. -->
                <Label Text="Title" Style="{StaticResource Strong}" IsVisible="{Binding IsSingle}" />
                <Border Style="{StaticResource Field}" IsVisible="{Binding IsSingle}">
                    <Entry Text="{Binding Title}" Placeholder="What did you capture?" MaxLength="{Binding TitleMaxLength}" />
                </Border>
                <Label Text="Description (optional)" Style="{StaticResource Strong}" />
                <Border Style="{StaticResource Field}">
                    <Editor Text="{Binding Description}" Placeholder="Where, when, the story behind the shot…"
                            AutoSize="TextChanges" MinimumHeightRequest="90" MaxLength="{Binding DescriptionMaxLength}" />
                </Border>
                <Label Text="Tags (optional)" Style="{StaticResource Strong}" />
                <Border Style="{StaticResource Field}">
                    <Entry Text="{Binding Tags}" Placeholder="fog wildlife london" Keyboard="Plain" />
                </Border>
                <Label Text="Separated by spaces. #hashtags in the description count too." Style="{StaticResource MutedText}" />
                <VerticalStackLayout Spacing="6" IsVisible="{Binding HasPlaces}">
                    <Label Text="Where was it taken? (optional)" Style="{StaticResource Strong}" />
                    <Border Style="{StaticResource Field}">
                        <Picker ItemsSource="{Binding PlaceOptions}" SelectedIndex="{Binding PlaceIndex}" Title="Where was it taken?"
                                TextColor="{DynamicResource Text}" />
                    </Border>
                    <Label Text="Shows the photo on the Spots map for members, with the place's name and pin. Your other places stay private."
                           Style="{StaticResource MutedText}" />
                </VerticalStackLayout>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout>
                        <Label Text="Ask for feedback" Style="{StaticResource Strong}" />
                        <Label Text="Members can rate composition, light and focus and comment. Only you see it."
                               Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding WantsFeedback}" VerticalOptions="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout>
                        <Label Text="Add my name as a watermark" Style="{StaticResource Strong}" />
                        <Label Text="“© your name” in the bottom-right corner. It's part of the image and can't be removed later."
                               Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding Watermark}" VerticalOptions="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout>
                        <Label Text="Allow downloads" Style="{StaticResource Strong}" />
                        <Label Text="When off, PhotoWorld hides sharing and saving the full-size photo. A deterrent: screens can still be captured."
                               Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding AllowDownload}" VerticalOptions="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout>
                        <Label Text="Show on the PhotoWorld home page" Style="{StaticResource Strong}" />
                        <Label Text="Anyone can see it in the public slideshow, with your name. Off by default."
                               Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding ShowOnHome}" VerticalOptions="Center" />
                </Grid>

                <Label Text="{Binding Progress}" Style="{StaticResource Strong}" HorizontalTextAlignment="Center"
                       IsVisible="{Binding Progress, Converter={StaticResource HasValue}}" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,8,0,0">
                    <Button Text="Clear" Command="{Binding ResetCommand}" Style="{StaticResource GhostButton}" />
                    <Button Grid.Column="1" Text="Upload" Command="{Binding UploadCommand}" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center" />
    </Grid>
</ContentPage>
