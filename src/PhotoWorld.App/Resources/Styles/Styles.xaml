<?xml version="1.0" encoding="UTF-8" ?>
<!-- PhotoWorld is dark-only, like the website. Headings use a serif: Georgia (the site's fallback) on iOS, Android's built-in serif. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== Defaults ===== -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource Ink}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource Ink}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource Accent}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource Text}" />
        <Setter Property="Shell.DisabledColor" Value="{DynamicResource Muted}" />
        <Setter Property="Shell.UnselectedColor" Value="{DynamicResource Muted}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource Ink2}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource Accent}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource Accent}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource Muted}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
        <Setter Property="TextColor" Value="{DynamicResource AccentInk}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource Text}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource Muted}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{DynamicResource Text}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource Muted}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{DynamicResource Text}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource Muted}" />
        <Setter Property="CancelButtonColor" Value="{DynamicResource Accent}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{DynamicResource Text}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource Accent}" />
        <Setter Property="ThumbColor" Value="{DynamicResource Text}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource Accent}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{DynamicResource Accent}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource Line}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Ink2}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
    </Style>

    <!-- ===== Named styles ===== -->
    <Style x:Key="Heading" TargetType="Label">
        <Setter Property="FontFamily" Value="{OnPlatform Android=serif, Default=Georgia-Bold}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="28" />
    </Style>

    <Style x:Key="Subheading" TargetType="Label">
        <Setter Property="FontFamily" Value="{OnPlatform Android=serif, Default=Georgia-Bold}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style x:Key="Strong" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>

    <Style x:Key="MutedText" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource Muted}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="Field" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Ink}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="10,2" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Text}" />
        <Setter Property="BorderColor" Value="{DynamicResource Line}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Accent}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="6" />
    </Style>

    <!-- One half of an "Everyone / Following" switch; a DataTrigger highlights the selected one. -->
    <Style x:Key="SegmentButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Muted}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>

    <!-- A tag (#fog): a small rounded chip. -->
    <Style x:Key="ChipButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Ink2}" />
        <Setter Property="TextColor" Value="{DynamicResource Text}" />
        <Setter Property="BorderColor" Value="{DynamicResource Line}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="MinimumHeightRequest" Value="30" />
        <Setter Property="Margin" Value="0,0,6,6" />
    </Style>

    <!-- Text drawn on photos (over the dark gradient or a badge): light in both themes. -->
    <Style x:Key="OnPhoto" TargetType="Label">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>
    <Style x:Key="OnPhotoMuted" TargetType="Label">
        <Setter Property="TextColor" Value="#D0D0CB" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- A photo with rounded corners (12, as on the website). In a PhotoCard it sits 6 in from the card's edge, so the
         card's 18 corners follow the photo's. -->
    <Style x:Key="PhotoFrame" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource PhotoBackground}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="PhotoCard" TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource Line}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Ink2}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="Padding" Value="6,6,6,0" />
    </Style>

    <!-- Small label on a photo tile: a place in a challenge, "Hidden"… -->
    <Style x:Key="TileBadge" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#D8141418" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Start" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Danger}" />
        <Setter Property="BorderColor" Value="{DynamicResource DangerLine}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>
</ResourceDictionary>
