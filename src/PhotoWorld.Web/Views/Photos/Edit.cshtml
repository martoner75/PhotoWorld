@model EditPhotoViewModel
@{
    ViewData["Title"] = "Edit photo";
}

<section class="container page narrow">
    <h1>Edit photo</h1>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form-card">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ThumbnailUrl" />
        <input type="hidden" asp-for="BeforeImageUrl" />
        <input type="hidden" asp-for="ReviewStatus" />

        @if (Model.ThumbnailUrl is not null)
        {
            <img class="edit-thumb" src="@Model.ThumbnailUrl" alt="" />
        }

        <div class="field">
            <label asp-for="Title"></label>
            <input asp-for="Title" maxlength="@PhotoUploadLimits.MaxTitleLength" />
            <span asp-validation-for="Title" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Description">Description <span class="text-muted">(optional)</span></label>
            <textarea asp-for="Description" rows="4" maxlength="@PhotoUploadLimits.MaxDescriptionLength"></textarea>
            <span asp-validation-for="Description" class="field-error"></span>
        </div>

        <partial name="_TagsField" model="Model.Tags" />

        <partial name="_PlaceField" model="new PlaceFieldViewModel(Model.PlaceId, Model.Places)" />

        <partial name="_FeedbackField" model="Model.WantsFeedback" />

        <partial name="_ProtectionField" model="new ProtectionFieldViewModel(false, false, Model.AllowDownload)" />
        @if (Model.Watermarked)
        {
            <p class="text-muted small">This photo carries your name as a watermark.</p>
        }

        <partial name="_ShowOnHomeField" model="Model.ShowOnHome" />

        <div class="form-actions">
            <a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
            <button type="submit" class="btn btn-accent">Save changes</button>
        </div>
    </form>

    @if (Model.ReviewStatus != PhotoReviewStatus.Rejected)
    {
        <h2 class="section-heading mt-4" id="before-after">Before &amp; after</h2>
        <div class="form-card">
            <p class="text-muted small m-0">Add the unedited shot and visitors can drag a slider across your photo to see
                what your editing did. It's processed like any upload: location and camera data are removed@(Model.Watermarked ? ", and it gets the same watermark" : "").</p>
            @if (Model.BeforeImageUrl is not null)
            {
                <img class="edit-thumb" src="@Model.BeforeImageUrl" alt="The before version" />
            }
            <form asp-action="AddBefore" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="before-form">
                <div class="field">
                    <label for="before-file">@(Model.BeforeImageUrl is null ? "Unedited photo" : "Replace with another")</label>
                    <input id="before-file" name="before" type="file" accept="@PhotoUploadLimits.AcceptAttribute" required />
                </div>
                @if (Model.ReviewStatus == PhotoReviewStatus.Approved && !User.HasClaim(PhotoWorldClaimTypes.IsAdmin, "true"))
                {
                    <p class="text-muted small">As it's a new image, your photo goes back for approval and is hidden from
                        others until an admin approves it again.</p>
                }
                <button type="submit" class="btn btn-ghost btn-sm">@(Model.BeforeImageUrl is null ? "Add before version" : "Replace before version")</button>
            </form>
            @if (Model.BeforeImageUrl is not null)
            {
                <form asp-action="RemoveBefore" asp-route-id="@Model.Id" method="post" data-confirm="Remove the before version?">
                    <button type="submit" class="btn btn-danger-ghost btn-sm">Remove before version</button>
                </form>
            }
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
