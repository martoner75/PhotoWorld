@model PostPageViewModel
@{
    var p = Model.Post;
    ViewData["Title"] = p.Title;
    // Comments open once a post is published (drafts and posts in review have none yet).
    var isPublished = p.Status == BlogPostStatus.Published;
}

<article class="container page post-page">
    @if (p.Moderation != ModerationState.Visible)
    {
        <partial name="_ModerationBanner" model='new ModerationBannerModel(p.Moderation, "post")' />
    }
    @if (p.CanReview)
    {
        <div class="alert moderation-banner draft-banner review-banner" role="status">
            <strong>Waiting for approval.</strong> <span>Only its author and admins can see this post until it's approved.</span>
            <div class="manage-actions">
                <partial name="_ReviewActions" model="new ReviewActionsModel(p.Id, p.Title, Context.Request.Path)" />
            </div>
        </div>
    }
    else if (p.Status == BlogPostStatus.Draft)
    {
        <div class="alert moderation-banner draft-banner" role="status">
            <strong>Draft.</strong> <span>Only you can see this post. Publish it from the editor when it's ready.</span>
        </div>
    }
    else if (p.Status == BlogPostStatus.Pending)
    {
        <div class="alert moderation-banner draft-banner" role="status">
            <strong>Waiting for approval.</strong> <span>An admin will review your post soon; it's published as soon as it's approved,
                and we'll let you know. Until then only you can see it.</span>
        </div>
    }
    else if (p.Status == BlogPostStatus.Rejected)
    {
        <div class="alert moderation-banner" role="status">
            <strong>Not approved.</strong>
            <span>@(p.ReviewNote is { Length: > 0 } note ? $"An admin's note: “{note}”." : "An admin sent this post back.")
                Edit it and submit it again when it's ready. Only you can see it.</span>
        </div>
    }

    <header class="post-header">
        <h1>@p.Title</h1>
        <div class="post-byline">
            <a class="photo-owner" asp-action="Member" asp-route-id="@p.Author.Id">
                <partial name="_Avatar" model="p.Author" />
                <span>@p.Author.DisplayName</span>
            </a>
            <span class="text-muted small">
                @(p.PublishedAt is { } published ? published.ToString("d MMMM yyyy") : "Not published")
                @if (p.PublishedAt is not null && p.UpdatedAt > p.PublishedAt.Value.AddMinutes(5))
                {
                    <text>· updated @p.UpdatedAt.ToString("d MMM yyyy")</text>
                }
            </span>
        </div>
        @if (p.CanEdit)
        {
            <div class="owner-actions">
                <a class="btn btn-ghost btn-sm" asp-action="Edit" asp-route-id="@p.Id">Edit</a>
                <form asp-action="Delete" asp-route-id="@p.Id" method="post"
                      onsubmit="return confirm('Delete this post and its comments? This can\'t be undone.');">
                    <button type="submit" class="btn btn-danger-ghost btn-sm">Delete</button>
                </form>
            </div>
        }
    </header>

    @* The API sanitizes every post body (BlogHtml): only basic formatting and the author's own photos remain. *@
    <div class="post-body">@Html.Raw(p.BodyHtml)</div>

    @if (p.Attachments.Count > 0)
    {
        <section class="attachments" aria-labelledby="attachments-title">
            <h2 id="attachments-title">Attachments</h2>
            <ul class="attachment-list">
                @foreach (var a in p.Attachments)
                {
                    <li>
                        <a href="@a.Url" class="attachment-name" download="@a.FileName">@a.FileName</a>
                        <span class="text-muted small">PDF · @FileSize.Format(a.SizeBytes)</span>
                    </li>
                }
            </ul>
        </section>
    }

    @if (isPublished)
    {
        <p class="post-more"><a asp-action="Member" asp-route-id="@p.Author.Id">More from @p.Author.DisplayName →</a></p>
    }

    @if (p.CanReport)
    {
        <p class="report-link"><a asp-action="Report" asp-route-id="@p.Id">Report this post</a></p>
    }

    @if (isPublished)
    {
        <section class="comments" id="comments">
            <h2>Comments <span class="text-muted" data-comment-count>@Model.Comments.Count</span></h2>
            <ul class="comment-list" id="comment-list">
                @foreach (var comment in Model.Comments)
                {
                    <partial name="_BlogComment" model="new BlogCommentItemViewModel(p.Id, comment)" />
                }
            </ul>
            <p class="text-muted small comment-empty" @(Model.Comments.Count > 0 ? "hidden" : "")>No comments yet. Start the conversation!</p>

            <form asp-action="Comment" asp-route-id="@p.Id" method="post" data-ajax="comment" class="comment-form">
                <label for="comment-text" class="visually-hidden">Add a comment</label>
                <textarea id="comment-text" name="text" rows="3" maxlength="@BlogLimits.CommentMax"
                          placeholder="What do you think?" required></textarea>
                <p class="field-error" data-comment-error hidden></p>
                <button type="submit" class="btn btn-accent btn-sm">Post comment</button>
            </form>
        </section>
    }
</article>

@section Scripts {
    <script src="~/js/photos.js" asp-append-version="true"></script>
}
