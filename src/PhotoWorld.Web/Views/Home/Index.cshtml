@model IReadOnlyList<ShowcasePhotoDto>
@{
    ViewData["Title"] = "Share the world through your lens";
}

<section class="hero">
    <div class="hero-inner">
        <p class="hero-eyebrow">A home for photographers everywhere</p>
        <h1>Share the world<br />through your lens.</h1>
        <p class="hero-lead">
            PhotoWorld is a place to show your best shots, follow photographers from every corner
            of the globe and talk light, gear and places with people who love it as much as you do.
        </p>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="hero-actions">
                <a class="btn btn-accent btn-lg" asp-controller="Photos" asp-action="Index">Open gallery</a>
                <a class="btn btn-ghost btn-lg" asp-controller="Photos" asp-action="Upload">Upload</a>
            </div>
        }
        else
        {
            <div class="hero-actions">
                <a class="btn btn-accent btn-lg" asp-controller="Account" asp-action="Register">Join PhotoWorld</a>
                <a class="btn btn-ghost btn-lg" asp-controller="Account" asp-action="Login">Sign in</a>
            </div>
        }
    </div>
</section>

@if (Model.Count > 0)
{
    <section class="showcase" aria-labelledby="showcase-heading">
        <div class="container">
            <h2 id="showcase-heading" class="showcase-heading">From our members</h2>
        </div>
        <div id="showcase" class="carousel slide carousel-fade showcase-carousel" data-bs-ride="carousel"
             data-bs-interval="5000" data-bs-pause="hover" data-bs-touch="true" data-bs-keyboard="true">
            <div class="carousel-indicators">
                @for (var i = 0; i < Model.Count; i++)
                {
                    <button type="button" data-bs-target="#showcase" data-bs-slide-to="@i"
                            class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")"
                            aria-label="Photo @(i + 1): @Model[i].Title"></button>
                }
            </div>
            <div class="carousel-inner">
                @for (var i = 0; i < Model.Count; i++)
                {
                    var photo = Model[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <a asp-controller="Photos" asp-action="Details" asp-route-id="@photo.Id">
                            <img src="@photo.ImageUrl" alt="@photo.Title" width="@photo.Width" height="@photo.Height"
                                 loading="@(i == 0 ? "eager" : "lazy")" />
                        </a>
                        <div class="showcase-caption">
                            <strong>@photo.Title</strong>
                            <span>by @photo.OwnerName</span>
                        </div>
                    </div>
                }
            </div>
            @if (Model.Count > 1)
            {
                <button class="carousel-control-prev" type="button" data-bs-target="#showcase" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous photo</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#showcase" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next photo</span>
                </button>
            }
        </div>
    </section>
}

<section class="features container">
    <article>
        <span class="feature-num">01</span>
        <h2>Share</h2>
        <p>Publish your photos with the story behind them: where, when and how you took the shot.</p>
    </article>
    <article>
        <span class="feature-num">02</span>
        <h2>Discover</h2>
        <p>Browse landscapes, street, portraits and more from photographers in every time zone.</p>
    </article>
    <article>
        <span class="feature-num">03</span>
        <h2>Connect</h2>
        <p>Follow the people who inspire you and swap feedback with a friendly global community.</p>
    </article>
</section>

@section Scripts {
    <script>
        // Respect "reduce motion": keep the slideshow still unless the visitor moves it.
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            const el = document.getElementById("showcase");
            if (el) bootstrap.Carousel.getOrCreateInstance(el, { ride: false, interval: false }).pause();
        }
    </script>
}
