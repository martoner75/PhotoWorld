<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PhotoWorld.App.ViewModels"
             xmlns:dto="clr-namespace:PhotoWorld.Shared.Photos"
             x:Class="PhotoWorld.App.Views.MemberPage"
             x:DataType="vm:MemberViewModel"
             Title="{Binding Member.DisplayName}">
    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <CollectionView ItemsSource="{Binding Items}" SelectionMode="None" Margin="12,8"
                        RemainingItemsThreshold="6" RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="{OnIdiom Phone=2, Tablet=4, Default=3}"
                                 HorizontalItemSpacing="10" VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.Header>
                <VerticalStackLayout Spacing="12" Padding="6,8,6,14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border WidthRequest="72" HeightRequest="72" StrokeShape="RoundRectangle 36" Padding="0"
                                Stroke="{DynamicResource Accent}" StrokeThickness="2" BackgroundColor="{DynamicResource Line}">
                            <Grid>
                                <Label Text="{Binding Initial}" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Image Source="{Binding Member.AvatarUrl}" Aspect="AspectFill" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding Member.DisplayName}" Style="{StaticResource Subheading}" />
                            <Label Text="{Binding Facts}" Style="{StaticResource MutedText}" />
                            <Label Text="{Binding FollowCounts}" Style="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Button Text="{Binding FollowButtonText}" Command="{Binding ToggleFollowCommand}" IsVisible="{Binding CanFollow}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding FollowedByMe}" Value="True">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                                <Setter Property="TextColor" Value="{DynamicResource Text}" />
                                <Setter Property="BorderColor" Value="{DynamicResource Line}" />
                                <Setter Property="BorderWidth" Value="1" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Button Text="Collections" Style="{StaticResource LinkButton}" HorizontalOptions="Start" Padding="4,0"
                            MinimumHeightRequest="30" Command="{Binding OpenCollectionsCommand}" />

                    <Border Padding="12,8" BackgroundColor="{DynamicResource DangerSoft}" Stroke="{DynamicResource DangerLine}" IsVisible="{Binding IsBlocked}">
                        <Label Text="Blocked. You don't see their photos, posts or comments, and they can't follow you or comment on your work."
                               FontSize="13" />
                    </Border>
                    <Button Text="{Binding BlockButtonText}" Command="{Binding ToggleBlockCommand}" IsVisible="{Binding CanBlock}"
                            Style="{StaticResource LinkButton}" TextColor="{DynamicResource Muted}" FontSize="13" HorizontalOptions="End"
                            Padding="4,0" MinimumHeightRequest="30" Margin="0,-6,0,0" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Wins}" Spacing="6" IsVisible="{Binding HasWins}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:ChallengeWinDto">
                                <Border Padding="12,8" Stroke="{DynamicResource AccentLine}" BackgroundColor="{DynamicResource AccentSoft}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenWinCommand, Source={RelativeSource AncestorType={x:Type vm:MemberViewModel}}, x:DataType=vm:MemberViewModel}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label TextColor="{DynamicResource Accent}" FontSize="14">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="🏆 Won “" />
                                                <Span Text="{Binding Title}" />
                                                <Span Text="{Binding EndsAt, StringFormat='” · {0:MMM yyyy}'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <Label Text="No photos shared yet." Style="{StaticResource MutedText}" FontSize="15"
                       HorizontalTextAlignment="Center" Margin="32,40" IsVisible="{Binding IsEmpty}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:PhotoSummaryDto">
                    <Border Padding="0" StrokeThickness="0" BackgroundColor="{DynamicResource PhotoBackground}"
                            SemanticProperties.Description="{Binding Title}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:MemberViewModel}}, x:DataType=vm:MemberViewModel}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid HeightRequest="{OnIdiom Phone=170, Tablet=220, Default=200}">
                            <Image Source="{Binding ThumbnailUrl}" Aspect="AspectFill" />
                            <!-- On the member's own photos only: approval still to come, or refused. -->
                            <Border Style="{StaticResource TileBadge}" IsVisible="{Binding ReviewStatus, Converter={StaticResource ReviewBadge}, ConverterParameter=visible}">
                                <Label Text="{Binding ReviewStatus, Converter={StaticResource ReviewBadge}}" FontSize="12" Style="{StaticResource OnPhoto}" />
                            </Border>
                            <Grid VerticalOptions="End" Padding="10,24,10,8">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="Transparent" Offset="0" />
                                        <GradientStop Color="#C0000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <Label Text="{Binding Title}" Style="{StaticResource OnPhoto}" FontSize="14" LineBreakMode="TailTruncation" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
