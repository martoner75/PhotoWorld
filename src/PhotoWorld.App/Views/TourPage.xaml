<?xml version="1.0" encoding="utf-8" ?>
<!-- The welcome tour, the app's version of the website's js/tour.js: shown over the tabs with a see-through background.
     Each step switches to its tab (the tab bar marks it as selected) and points at it from a note above the tab bar. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="PhotoWorld.App.Views.TourPage"
             BackgroundColor="Transparent"
             Shell.NavBarIsVisible="False"
             ios:Page.ModalPresentationStyle="OverFullScreen"
             ios:Page.UseSafeArea="True">
    <Grid RowDefinitions="*,Auto">
        <BoxView Color="Black" Opacity="0.55" />

        <VerticalStackLayout x:Name="Note" Padding="16,0" Spacing="0">
            <Border BackgroundColor="{DynamicResource Ink2}" Stroke="{DynamicResource Line}" StrokeShape="RoundRectangle 14"
                    Padding="18,14,18,10" MaximumWidthRequest="420">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="CountLabel" Style="{StaticResource MutedText}" />
                    <Label x:Name="TitleLabel" Style="{StaticResource Subheading}" />
                    <Label x:Name="TextLabel" TextColor="{DynamicResource Text}" FontSize="15" LineHeight="1.2" />
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,10,0,0">
                        <Button x:Name="SkipButton" Text="Skip tour" Style="{StaticResource LinkButton}" Padding="0" Clicked="OnSkip" />
                        <Button x:Name="BackButton" Grid.Column="2" Text="Back" Style="{StaticResource GhostButton}" Clicked="OnBack" />
                        <Button x:Name="ShareButton" Grid.Column="2" Text="Share a photo" Style="{StaticResource GhostButton}" Clicked="OnShare" />
                        <Button x:Name="NextButton" Grid.Column="3" Text="Next" Clicked="OnNext" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <!-- Points down at the step's tab; placed in UpdateArrow. -->
            <Label x:Name="Arrow" Text="▼" TextColor="{DynamicResource Accent}" FontSize="24" HorizontalOptions="Start" Margin="0,-2,0,4" />
        </VerticalStackLayout>

        <!-- Over the tab bar: left clear while a tab is being shown, so it stands out from the dimmed page. -->
        <BoxView x:Name="TabBarGap" Grid.Row="1" Color="Black" Opacity="0" HeightRequest="{OnPlatform iOS=49, Android=56}" />
    </Grid>
</ContentPage>
