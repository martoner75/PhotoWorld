@model CollectionFormViewModel
@{
    var isNew = Model.Id is null;
    ViewData["Title"] = isNew ? "New collection" : "Edit collection";
}

<section class="container page narrow">
    <h1>@ViewData["Title"]</h1>

    <form asp-action="@(isNew ? "New" : "Edit")" asp-route-id="@Model.Id" method="post" class="form-card">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="field">
            <label asp-for="Title"></label>
            <input asp-for="Title" maxlength="@CollectionLimits.TitleMax" placeholder="Fog inspiration" />
            <span asp-validation-for="Title" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Description">Description <span class="text-muted">(optional)</span></label>
            <textarea asp-for="Description" rows="3" maxlength="@CollectionLimits.DescriptionMax"></textarea>
            <span asp-validation-for="Description" class="field-error"></span>
        </div>
        <label class="check-row">
            <input asp-for="IsPublic" type="checkbox" />
            <span><strong>Public</strong><br />
                <span class="text-muted small">Shown on your member page to other members. Otherwise only you can see it.</span></span>
        </label>
        <div class="form-actions">
            <a class="btn btn-ghost" asp-action="@(isNew ? "Index" : "Details")" asp-route-id="@Model.Id">Cancel</a>
            <button type="submit" class="btn btn-accent">@(isNew ? "Create collection" : "Save changes")</button>
        </div>
    </form>
</section>
