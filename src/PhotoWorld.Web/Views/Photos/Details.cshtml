@model PhotoPageViewModel
@{
    var p = Model.Photo;
    ViewData["Title"] = p.Title;
    var camera = p.Camera.Rows().ToList();
}

@if (p.Moderation != ModerationState.Visible)
{
    <div class="container">
        <partial name="_ModerationBanner" model='new ModerationBannerModel(p.Moderation, "photo")' />
    </div>
}
@if (p.CanReview)
{
    <div class="container">
        <div class="alert moderation-banner draft-banner review-banner" role="status">
            <strong>Waiting for approval.</strong> <span>Only its owner and admins can see this photo until it's approved.</span>
            <div class="manage-actions">
                <partial name="_PhotoReviewActions" model="new PhotoReviewActionsModel(p.Id, Context.Request.Path)" />
            </div>
        </div>
    </div>
}
else if (p.CanEdit && p.ReviewStatus == PhotoReviewStatus.Pending)
{
    <div class="container">
        <div class="alert moderation-banner draft-banner" role="status">
            <strong>Waiting for approval.</strong> <span>An admin will look at your photo soon. Until it's approved, only you
                can see it; we'll let you know when it's in the gallery.</span>
        </div>
    </div>
}
else if (p.CanEdit && p.ReviewStatus == PhotoReviewStatus.Rejected)
{
    <div class="container">
        <div class="alert moderation-banner" role="status">
            <strong>Not approved.</strong>
            <span>@(p.ReviewNote is { Length: > 0 } note ? $"An admin's note: “{note}”." : "An admin didn't approve this photo.")
                Only you can see it. You can delete it.</span>
        </div>
    </div>
}

<section class="container page photo-page">
    <div class="photo-stage">
        @if (p.BeforeImageUrl is not null)
        {
            var protect = !(p.AllowDownload || p.CanEdit);
            @* Before/after: the unedited shot is laid over the photo and clipped at the slider's position. *@
            <div class="compare" data-compare>
                <img src="@p.ImageUrl" alt="@p.Title" width="@p.Width" height="@p.Height" class="compare-after @(protect ? "no-save" : "")"
                     draggable="false" data-no-save="@(protect ? "" : null)" />
                <img src="@p.BeforeImageUrl" alt="@p.Title, before editing" class="compare-before @(protect ? "no-save" : "")"
                     draggable="false" data-no-save="@(protect ? "" : null)" />
                <span class="compare-label compare-label-before" aria-hidden="true">Before</span>
                <span class="compare-label compare-label-after" aria-hidden="true">After</span>
                <input type="range" min="0" max="100" value="50" class="compare-range" data-compare-range
                       aria-label="Compare before and after: slide right to show more of the unedited photo" />
            </div>
        }
        else if (p.AllowDownload || p.CanEdit)
        {
            <a href="@p.ImageUrl" target="_blank" rel="noopener" title="Open full size">
                <img src="@p.ImageUrl" alt="@p.Title" width="@p.Width" height="@p.Height" />
            </a>
        }
        else
        {
            @* The owner turned downloads off: no full-size link, no right-click "save image", no dragging out. *@
            <img src="@p.ImageUrl" alt="@p.Title" width="@p.Width" height="@p.Height" class="no-save" draggable="false" data-no-save />
        }
    </div>

    <aside class="photo-panel">
        <h1>@p.Title</h1>
        <a class="photo-owner" asp-controller="Members" asp-action="Details" asp-route-id="@p.Owner.Id">
            <partial name="_Avatar" model="p.Owner" />
            <span>@p.Owner.DisplayName</span>
        </a>
        @if (p.PhotoOfTheDay is { } featured)
        {
            <p class="potd-badge">⭐ Photo of the day · @featured.ToString("d MMMM yyyy")</p>
        }
        <p class="text-muted small">
            Shared @p.CreatedAt.ToString("d MMMM yyyy")
            @if (p.CanEdit && p.ShowOnHome)
            {
                <span class="home-badge" title="This photo appears in the public home-page slideshow">· On the home page</span>
            }
            @if (p.CanEdit && !p.AllowDownload)
            {
                <span title="Other members don't get the full-size link or saving">· Downloads off</span>
            }
        </p>

        @if (p.Place is { } place)
        {
            <p class="photo-place">
                <a asp-controller="Spots" asp-action="Index" asp-route-photo="@p.Id">📍 @place.Name</a>
            </p>
            @* Planning a visit: today's light at this spot. *@
            <details class="light-details">
                <summary>🌅 Golden hour here today</summary>
                <partial name="_LightPlanner" model='new LightPlannerModel("photo", "Light at this spot today",
                    SunTimes.For(SunTimes.LocalDate(DateTimeOffset.UtcNow, place.Longitude), place.Latitude, place.Longitude))' />
            </details>
        }

        @if (p.Tags is { Count: > 0 } tags)
        {
            <p class="tag-list">
                @foreach (var tag in tags)
                {
                    <a class="tag-chip" asp-action="Index" asp-route-tag="@tag">#@tag</a>
                }
            </p>
        }

        @if (p.Description is not null)
        {
            <p class="photo-description">@p.Description</p>
        }

        <form asp-action="Like" asp-route-id="@p.Id" method="post" data-ajax="like" class="like-form">
            <input type="hidden" name="liked" value="@(p.LikedByMe ? "false" : "true")" />
            <button type="submit" class="btn-like @(p.LikedByMe ? "is-liked" : "")" aria-pressed="@(p.LikedByMe ? "true" : "false")">
                <span class="btn-like-heart" aria-hidden="true">♥</span>
                <span data-like-label>@(p.LikedByMe ? "Liked" : "Like")</span>
                <span class="btn-like-count" data-like-count>@p.LikeCount</span>
            </button>
        </form>

        <p class="photo-save"><a class="btn btn-ghost btn-sm" asp-controller="Collections" asp-action="Save" asp-route-photoId="@p.Id">＋ Save to a collection</a></p>

        @if (camera.Count > 0)
        {
            <dl class="camera-details">
                @foreach (var (label, value, search) in camera)
                {
                    <dt>@label</dt>
                    @if (search is null)
                    {
                        <dd>@value</dd>
                    }
                    else
                    {
                        <dd><a asp-action="Index" asp-all-route-data="search" title="More photos with this @label.ToLowerInvariant()">@value</a></dd>
                    }
                }
            </dl>
        }

        @if (p.CanEdit)
        {
            <div class="owner-actions">
                <a class="btn btn-ghost btn-sm" asp-action="Edit" asp-route-id="@p.Id">Edit</a>
                <form asp-action="Delete" asp-route-id="@p.Id" method="post"
                      onsubmit="return confirm('Delete this photo? This can\'t be undone.');">
                    <button type="submit" class="btn btn-danger-ghost btn-sm">Delete</button>
                </form>
            </div>
        }

        @if (User.HasClaim(PhotoWorldClaimTypes.IsAdmin, "true") && p.Moderation == ModerationState.Visible)
        {
            <details class="admin-feature">
                <summary>⭐ Feature as photo of the day (admin)</summary>
                <form asp-controller="Admin" asp-action="SetPhotoOfTheDay" method="post" class="notify-form">
                    <input type="hidden" name="photoId" value="@p.Id" />
                    <div class="field">
                        <label for="potd-date">Day (UTC)</label>
                        <input id="potd-date" name="date" type="date" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="field">
                        <label for="potd-note">Note <span class="text-muted">(optional, shown with it)</span></label>
                        <input id="potd-note" name="note" maxlength="@PhotoOfTheDayLimits.NoteMax" placeholder="Wonderful morning light" />
                    </div>
                    <button type="submit" class="btn btn-accent btn-sm">Feature it</button>
                </form>
            </details>
        }

        @if (p.CanReport)
        {
            <p class="report-link"><a asp-action="Report" asp-route-id="@p.Id">Report this photo</a></p>
        }

        @if (Model.Feedback is { } feedback && (feedback.WantsFeedback || feedback.Count > 0 || p.CanEdit))
        {
            <partial name="_Feedback" model="Model" />
        }

        <section class="comments" id="comments">
            <h2>Comments <span class="text-muted" data-comment-count>@Model.Comments.Count</span></h2>
            <ul class="comment-list" id="comment-list">
                @foreach (var comment in Model.Comments)
                {
                    <partial name="_Comment" model="new CommentItemViewModel(p.Id, comment)" />
                }
            </ul>
            <p class="text-muted small comment-empty" @(Model.Comments.Count > 0 ? "hidden" : "")>No comments yet. Say something nice!</p>

            <form asp-action="Comment" asp-route-id="@p.Id" method="post" data-ajax="comment" class="comment-form">
                <label for="comment-text" class="visually-hidden">Add a comment</label>
                <textarea id="comment-text" name="text" rows="2" maxlength="@PhotoUploadLimits.MaxCommentLength"
                          placeholder="Add a comment…" required></textarea>
                <p class="field-error" data-comment-error hidden></p>
                <button type="submit" class="btn btn-accent btn-sm">Post</button>
            </form>
        </section>
    </aside>
</section>

@section Scripts {
    <script src="~/js/photos.js" asp-append-version="true"></script>
}
