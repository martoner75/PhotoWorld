<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PhotoWorld.App.ViewModels"
             x:Class="PhotoWorld.App.Views.ChallengePage"
             x:DataType="vm:ChallengeViewModel"
             Title="{Binding Title}">
    <Grid>
        <CollectionView ItemsSource="{Binding Entries}" SelectionMode="None" Margin="12,8">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="{OnIdiom Phone=2, Tablet=4, Default=3}"
                                 HorizontalItemSpacing="10" VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.Header>
                <VerticalStackLayout Spacing="8" Padding="4,8,4,14">
                    <Label Text="{Binding When}" TextColor="{StaticResource Accent}" FontSize="13" Style="{StaticResource Strong}" />
                    <Label Text="{Binding Title}" Style="{StaticResource Heading}" />
                    <Label Text="{Binding Dates}" Style="{StaticResource MutedText}" />
                    <Label Text="{Binding Challenge.Challenge.Description}" FontSize="16"
                           IsVisible="{Binding Challenge.Challenge.Description, Converter={StaticResource HasValue}}" />
                    <Label Text="{Binding Rules}" Style="{StaticResource MutedText}" FontSize="14" />
                    <Button Text="Enter a photo" Command="{Binding EnterCommand}" IsVisible="{Binding CanEnter}" Margin="0,6,0,0" />
                    <Label Text="{Binding EnterHint}" Style="{StaticResource MutedText}"
                           IsVisible="{Binding EnterHint, Converter={StaticResource HasValue}}" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <Label Text="No entries yet." Style="{StaticResource MutedText}" FontSize="15"
                       HorizontalTextAlignment="Center" Margin="32,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:EntryItem">
                    <Border Padding="0" StrokeThickness="0" BackgroundColor="{StaticResource PhotoBackground}"
                            SemanticProperties.Description="{Binding Photo.Title}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenPhotoCommand, Source={RelativeSource AncestorType={x:Type vm:ChallengeViewModel}}, x:DataType=vm:ChallengeViewModel}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid HeightRequest="{OnIdiom Phone=200, Tablet=250, Default=230}">
                            <Image Source="{Binding Photo.ThumbnailUrl}" Aspect="AspectFill" />
                            <Border Style="{StaticResource TileBadge}" IsVisible="{Binding Badge, Converter={StaticResource HasValue}}">
                                <Label Text="{Binding Badge}" FontSize="12" Style="{StaticResource Strong}" />
                            </Border>
                            <Grid VerticalOptions="End" Padding="10,24,10,6">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="Transparent" Offset="0" />
                                        <GradientStop Color="#C0000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="{Binding Photo.Title}" Style="{StaticResource Strong}" FontSize="14" LineBreakMode="TailTruncation" />
                                    <Label Style="{StaticResource MutedText}" FontSize="12" LineBreakMode="TailTruncation">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Photo.Owner.DisplayName}" />
                                                <Span Text="  ♥ " />
                                                <Span Text="{Binding Votes}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Button Text="Withdraw" Style="{StaticResource LinkButton}" TextColor="{StaticResource Danger}"
                                            FontSize="12" Padding="0,4" MinimumHeightRequest="28" HorizontalOptions="Start"
                                            IsVisible="{Binding CanWithdraw}" CommandParameter="{Binding .}"
                                            Command="{Binding WithdrawCommand, Source={RelativeSource AncestorType={x:Type vm:ChallengeViewModel}}, x:DataType=vm:ChallengeViewModel}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center" />
    </Grid>
</ContentPage>
