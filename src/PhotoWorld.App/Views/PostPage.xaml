<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PhotoWorld.App.ViewModels"
             x:Class="PhotoWorld.App.Views.PostPage"
             x:DataType="vm:PostViewModel"
             Title="{Binding Post.Title}">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="ReportItem" Text="Report" Command="{Binding ReportPostCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">
        <!-- The post body is HTML the API has sanitized; links open in the browser (see code-behind). -->
        <WebView Source="{Binding Body}" BackgroundColor="{DynamicResource Ink}" Navigating="OnNavigating" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center" />
        <Border Grid.Row="1" StrokeShape="Rectangle" StrokeThickness="0" Padding="16,10">
            <Button Text="{Binding CommentsLabel}" Command="{Binding OpenCommentsCommand}" Style="{StaticResource GhostButton}" />
        </Border>
    </Grid>
</ContentPage>
