@model MemberPageViewModel
@{
    var m = Model.Member;
    ViewData["Title"] = m.DisplayName;
}

<section class="container page">
    <header class="member-header">
        <partial name="_Avatar" model="new UserSummaryDto(m.Id, m.DisplayName, m.AvatarUrl)" />
        <div>
            <h1>@m.DisplayName</h1>
            <p class="text-muted">
                Member since @m.MemberSince.ToString("MMMM yyyy") ·
                @m.PhotoCount @(m.PhotoCount == 1 ? "photo" : "photos") ·
                <a asp-controller="Blogs" asp-action="Member" asp-route-id="@m.Id">@(m.IsMe ? "My blog" : "Blog")</a> ·
                @if (m.IsMe)
                {
                    <a asp-controller="Collections" asp-action="Index">My collections</a>
                }
                else
                {
                    <a asp-controller="Collections" asp-action="Member" asp-route-id="@m.Id">Collections</a>
                }
                @if (m.IsMe)
                {
                    @:· <a asp-controller="Places" asp-action="Index">My places</a>
                }
            </p>
            <p class="text-muted small member-follows">
                @m.FollowerCount @(m.FollowerCount == 1 ? "follower" : "followers") ·
                @(m.IsMe ? "following" : "follows") @m.FollowingCount @(m.FollowingCount == 1 ? "member" : "members")
            </p>
        </div>
        @if (m.IsMe)
        {
            <div class="member-actions">
                <a class="btn btn-ghost" asp-controller="Account" asp-action="Settings">Account settings</a>
                <a class="btn btn-accent" asp-controller="Photos" asp-action="Upload">Upload a photo</a>
            </div>
        }
        else if (m.BlockedByMe)
        {
            <form class="member-actions" asp-action="Block" asp-route-id="@m.Id" method="post">
                <input type="hidden" name="block" value="false" />
                <button type="submit" class="btn btn-ghost">Unblock</button>
            </form>
        }
        else
        {
            <form class="member-actions" asp-action="Follow" asp-route-id="@m.Id" method="post">
                <input type="hidden" name="follow" value="@(m.FollowedByMe ? "false" : "true")" />
                @if (m.FollowedByMe)
                {
                    <button type="submit" class="btn btn-ghost btn-following" aria-pressed="true">
                        <span class="btn-following-on">Following</span><span class="btn-following-off">Unfollow</span>
                    </button>
                }
                else
                {
                    <button type="submit" class="btn btn-accent" aria-pressed="false">Follow</button>
                }
            </form>
        }
    </header>

    @if (m.BlockedByMe)
    {
        <div class="alert moderation-banner" role="status">
            <strong>Blocked.</strong> You don't see @m.DisplayName's photos, posts or comments, and they can't follow you
            or comment on your photos and posts. They aren't told.
        </div>
    }

    @if (m.Wins is { Count: > 0 } wins)
    {
        <ul class="trophies" aria-label="Challenges won">
            @foreach (var win in wins)
            {
                <li>
                    <a asp-controller="Challenges" asp-action="Details" asp-route-id="@win.ChallengeId">
                        <span aria-hidden="true">🏆</span> Won “@win.Title” · @win.EndsAt.ToString("MMM yyyy")
                    </a>
                </li>
            }
        </ul>
    }

    @if (Model.Photos.TotalCount == 0)
    {
        <div class="empty-state">
            @if (m.IsMe)
            {
                <p>You haven't shared any photos yet.</p>
                <a class="btn btn-accent" asp-controller="Photos" asp-action="Upload">Share your first photo</a>
            }
            else if (m.BlockedByMe)
            {
                <p>Their photos are hidden because you blocked them.</p>
            }
            else
            {
                <p>@m.DisplayName hasn't shared any photos yet.</p>
            }
        </div>
    }
    else
    {
        <partial name="_PhotoGrid" model="Model.Photos" />
    }

    @if (!m.IsMe && !m.BlockedByMe)
    {
        <form asp-action="Block" asp-route-id="@m.Id" method="post" class="report-link member-block"
              data-confirm="Block @m.DisplayName? You won't see their photos, posts or comments, and they won't be able to follow you or comment on your work.">
            <input type="hidden" name="block" value="true" />
            <button type="submit" class="btn-link-muted">Block @m.DisplayName</button>
        </form>
    }
</section>
