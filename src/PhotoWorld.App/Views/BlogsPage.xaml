<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:PhotoWorld.App.Views"
             xmlns:vm="clr-namespace:PhotoWorld.App.ViewModels"
             xmlns:dto="clr-namespace:PhotoWorld.Shared.Blogs"
             x:Class="PhotoWorld.App.Views.BlogsPage"
             x:DataType="vm:BlogsViewModel"
             Title="Blogs">
    <ContentPage.ToolbarItems>
        <views:ThemeToolbarItem />
    </ContentPage.ToolbarItems>
    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <CollectionView ItemsSource="{Binding Items}" SelectionMode="None" Margin="12,8"
                        RemainingItemsThreshold="4" RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="{OnIdiom Phone=1, Tablet=2, Default=2}"
                                 HorizontalItemSpacing="12" VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.Header>
                <Border Padding="3" StrokeShape="RoundRectangle 10" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="3">
                        <Button Text="Everyone" Style="{StaticResource SegmentButton}"
                                Command="{Binding ShowFollowingCommand}" CommandParameter="everyone">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding Following}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Line}" />
                                    <Setter Property="TextColor" Value="{DynamicResource Text}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1" Text="Following" Style="{StaticResource SegmentButton}"
                                Command="{Binding ShowFollowingCommand}" CommandParameter="following">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding Following}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Line}" />
                                    <Setter Property="TextColor" Value="{DynamicResource Text}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                </Border>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <Label Text="{Binding EmptyMessage}" Style="{StaticResource MutedText}" FontSize="15"
                       HorizontalTextAlignment="Center" Margin="32,80" IsVisible="{Binding IsEmpty}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:BlogPostSummaryDto">
                    <Border Padding="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:BlogsViewModel}}, x:DataType=vm:BlogsViewModel}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout>
                            <Image Source="{Binding CoverUrl}" Aspect="AspectFill" HeightRequest="180"
                                   BackgroundColor="{DynamicResource PhotoBackground}"
                                   IsVisible="{Binding CoverUrl, Converter={StaticResource HasValue}}" />
                            <VerticalStackLayout Padding="14,12" Spacing="6">
                                <Label Text="{Binding Title}" Style="{StaticResource Subheading}" />
                                <Label Text="{Binding Excerpt}" TextColor="{DynamicResource Muted}" MaxLines="3" LineBreakMode="TailTruncation" />
                                <!-- A button (not a tap on the label) so tapping the name opens the member page without also opening the post. -->
                                <Button Text="{Binding Author.DisplayName}" Style="{StaticResource LinkButton}" FontSize="13"
                                        Padding="0,2" MinimumHeightRequest="28" HorizontalOptions="Start" CommandParameter="{Binding .}"
                                        Command="{Binding OpenAuthorCommand, Source={RelativeSource AncestorType={x:Type vm:BlogsViewModel}}, x:DataType=vm:BlogsViewModel}" />
                                <Label Style="{StaticResource MutedText}" Margin="0,-6,0,0">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding PublishedAt, StringFormat='{0:d MMM yyyy}'}" />
                                            <Span Text="{Binding CommentCount, StringFormat=' · {0} comments'}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
