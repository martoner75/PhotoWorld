@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · PhotoCommunity</title>
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" />
    @* Light, dark or automatic (follow the device), remembered in this browser. Runs before the page paints, so there's
       no flash of the wrong colours. site.css and Bootstrap's own components both read the attributes set here. *@
    <script>
        (() => {
            // The theme choice lives in localStorage only if the visitor accepted preference storage (Cookie
            // settings); otherwise in sessionStorage, which the browser clears when it closes.
            const dark = matchMedia("(prefers-color-scheme: dark)");
            const store = () => /(?:^|; )PhotoWorld\.Consent=preferences(?:;|$)/.test(document.cookie) ? localStorage : sessionStorage;
            const apply = () => {
                let choice = "auto";
                try { choice = store().getItem("pw-theme") || "auto"; } catch { }
                const theme = choice === "light" || choice === "dark" ? choice : dark.matches ? "dark" : "light";
                const root = document.documentElement;
                root.dataset.theme = root.dataset.bsTheme = theme;
                root.dataset.themeChoice = choice;
                document.querySelector('meta[name="theme-color"]')?.setAttribute("content", theme === "dark" ? "#1e2127" : "#ffffff");
            };
            window.pwSetTheme = (choice) => {
                try { choice === "auto" ? store().removeItem("pw-theme") : store().setItem("pw-theme", choice); } catch { }
                apply();
            };
            // Consent changed: carry the current choice over to the right storage and clear the other one.
            window.pwMoveTheme = () => {
                try {
                    const choice = localStorage.getItem("pw-theme") || sessionStorage.getItem("pw-theme");
                    localStorage.removeItem("pw-theme"); sessionStorage.removeItem("pw-theme");
                    if (choice) store().setItem("pw-theme", choice);
                } catch { }
            };
            apply();
            dark.addEventListener("change", apply);
        })();
    </script>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Inter:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @await RenderSectionAsync("Head", required: false)
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg site-nav">
            <div class="container">
                <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true"></span> PhotoCommunity
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var avatar = User.FindFirstValue(PhotoWorldClaimTypes.AvatarUrl);
                        var controller = ViewContext.RouteData.Values["controller"] as string;
                        // The section being viewed is highlighted, for sighted members and screen readers alike.
                        string? Active(string section) => controller == section ? "active" : null;
                        string? Current(string section) => controller == section ? "page" : null;
                        // Clubs, walks and challenges are one "Community" section, the same group as the app's Community tab.
                        var inCommunity = controller is "Clubs" or "Walks" or "Challenges";
                        @* Site sections on the left; search, create, activity and the member's own menu on the right.
                           The same groups as the app: Gallery (with Explore), Blogs, Community, Places, and the member's own. *@
                        <ul class="navbar-nav me-auto ms-lg-3 gap-lg-1">
                            <li class="nav-item"><a class="nav-link @Active("Photos")" aria-current="@Current("Photos")" asp-controller="Photos" asp-action="Index">Gallery</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Search")" aria-current="@Current("Search")" asp-controller="Search" asp-action="Explore">Explore</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Blogs")" aria-current="@Current("Blogs")" asp-controller="Blogs" asp-action="Index">Blogs</a></li>
                            <li class="nav-item dropdown">
                                <button type="button" class="nav-link dropdown-toggle @(inCommunity ? "active" : null)" data-bs-toggle="dropdown"
                                        aria-expanded="false" aria-current="@(inCommunity ? "page" : null)">Community</button>
                                <ul class="dropdown-menu community-menu">
                                    <li><a class="dropdown-item @Active("Clubs")" aria-current="@Current("Clubs")" asp-controller="Clubs" asp-action="Index"><partial name="_LineIcon" model="LineIcons.Clubs" />Clubs</a></li>
                                    <li><a class="dropdown-item @Active("Walks")" aria-current="@Current("Walks")" asp-controller="Walks" asp-action="Index"><partial name="_LineIcon" model="LineIcons.Walks" />Photo walks</a></li>
                                    <li><a class="dropdown-item @Active("Challenges")" aria-current="@Current("Challenges")" asp-controller="Challenges" asp-action="Index"><partial name="_LineIcon" model="LineIcons.Challenges" />Challenges</a></li>
                                </ul>
                            </li>
                            <li class="nav-item"><a class="nav-link @Active("Places")" aria-current="@Current("Places")" asp-controller="Places" asp-action="Index">Places</a></li>
                        </ul>
                        <ul class="navbar-nav align-items-lg-center gap-lg-2">
                            <li class="nav-item">
                                <form asp-controller="Search" asp-action="Index" method="get" class="nav-search" role="search">
                                    <input name="q" maxlength="100" placeholder="Search" aria-label="Search PhotoCommunity" />
                                </form>
                            </li>
                            @* Everything a member can start, in one place (the app's ＋ offers the same). *@
                            <li class="nav-item dropdown">
                                <button type="button" class="btn btn-accent btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">＋ Create</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Photos" asp-action="Upload">Upload a photo</a></li>
                                    <li><a class="dropdown-item" asp-controller="Photos" asp-action="UploadMany">Upload several photos</a></li>
                                    <li><a class="dropdown-item" asp-controller="Blogs" asp-action="New">Write a blog post</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-controller="Walks" asp-action="New">Organise a photo walk</a></li>
                                    <li><a class="dropdown-item" asp-controller="Clubs" asp-action="New">Start a club</a></li>
                                    <li><a class="dropdown-item" asp-controller="Collections" asp-action="New">New collection</a></li>
                                </ul>
                            </li>
                            <partial name="_GuideLink" />
                            <li class="nav-item">
                                <a class="nav-link nav-bell" asp-controller="Activity" asp-action="Index" aria-label="Activity" data-activity-bell>
                                    <svg class="nav-bell-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"
                                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M3.5 13.5h4.2l1.6 2.5h5.4l1.6-2.5h4.2" /><path d="M5.6 5.5h12.8l2.1 8v4.5a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2v-4.5Z" />
                                    </svg><span class="nav-bell-count" data-activity-count hidden></span>
                                </a>
                            </li>
                            @* On wide screens a dropdown under the avatar; in the collapsed mobile menu its items are listed in full. *@
                            <li class="nav-item dropdown nav-account">
                                <button type="button" class="nav-link nav-user dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"
                                        aria-label="Your account: @User.Identity.Name">
                                    @if (avatar is not null)
                                    {
                                        <img src="@avatar" alt="" referrerpolicy="no-referrer" />
                                    }
                                    else
                                    {
                                        <span class="nav-user-initial" aria-hidden="true">@User.Identity.Name?.FirstOrDefault()</span>
                                    }
                                    <span class="nav-user-name">@User.Identity.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li class="dropdown-header">@User.Identity.Name</li>
                                    @* The member's own things, the same list as the app's Me tab. *@
                                    <li><a class="dropdown-item" asp-controller="Members" asp-action="Me">My profile</a></li>
                                    <li><a class="dropdown-item @Active("Collections")" aria-current="@Current("Collections")" asp-controller="Collections" asp-action="Index">My collections</a></li>
                                    <li><a class="dropdown-item" asp-controller="Clubs" asp-action="Mine">My clubs</a></li>
                                    <li><a class="dropdown-item @Active("Portfolio")" aria-current="@Current("Portfolio")" asp-controller="Portfolio" asp-action="Edit">My portfolio</a></li>
                                    <li><a class="dropdown-item" asp-controller="Members" asp-action="Insights">Insights</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Settings">Settings</a></li>                                    @if (User.HasClaim(PhotoWorldClaimTypes.IsAdmin, "true"))
                                    {
                                        <li><a class="dropdown-item @Active("Admin")" aria-current="@Current("Admin")" asp-controller="Admin" asp-action="Users">Admin</a></li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li class="dropdown-theme">
                                        <span id="nav-theme-label">Theme</span>
                                        <div class="theme-choices" role="group" aria-labelledby="nav-theme-label">
                                            <button type="button" data-theme-choice="light">Light</button>
                                            <button type="button" data-theme-choice="dark">Dark</button>
                                            <button type="button" data-theme-choice="auto">Auto</button>
                                        </div>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">Sign out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                            <partial name="_GuideLink" />
                            <partial name="_ThemeToggle" />
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a></li>
                            <li class="nav-item"><a class="btn btn-accent btn-sm" asp-controller="Account" asp-action="Register">Join</a></li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["Flash"] is string flash)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show" role="status" data-auto-dismiss="3000">
                @flash
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        @* A page can put a row above the copyright and social links (the home page: the app store badges). *@
        @if (IsSectionDefined("FooterTop"))
        {
            <div class="container footer-top">@await RenderSectionAsync("FooterTop")</div>
        }
        <div class="container footer-row">
            <div>
                &copy; @DateTime.Now.Year PhotoCommunity · <a asp-controller="Home" asp-action="Terms">Terms</a> · <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                · <button type="button" class="link-button" data-cookie-settings>Cookie settings</button>
            </div>
            @* Each link shows only once its page URL is set (Site:Social in appsettings.json). *@
            @{
                var social = Configuration.GetSection("Site:Social");
                var facebook = social["Facebook"];
                var instagram = social["Instagram"];
                var youtube = social["YouTube"];
            }
            @if (!string.IsNullOrWhiteSpace(facebook) || !string.IsNullOrWhiteSpace(instagram) || !string.IsNullOrWhiteSpace(youtube))
            {
                <ul class="footer-social" aria-label="PhotoCommunity on social media">
                    @if (!string.IsNullOrWhiteSpace(facebook))
                    {
                        <li>
                            <a href="@facebook" rel="noopener" target="_blank" aria-label="PhotoCommunity on Facebook" title="Facebook">
                                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M24 12a12 12 0 1 0-13.9 11.9v-8.4h-3V12h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9V12h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12Z" /></svg>
                            </a>
                        </li>
                    }
                    @if (!string.IsNullOrWhiteSpace(instagram))
                    {
                        <li>
                            <a href="@instagram" rel="noopener" target="_blank" aria-label="PhotoCommunity on Instagram" title="Instagram">
                                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" /></svg>
                            </a>
                        </li>
                    }
                    @if (!string.IsNullOrWhiteSpace(youtube))
                    {
                        <li>
                            <a href="@youtube" rel="noopener" target="_blank" aria-label="PhotoCommunity on YouTube" title="YouTube">
                                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z" /></svg>
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    </footer>
    <partial name="_CookieBanner" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
