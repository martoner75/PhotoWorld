@model PagedResult<BlogPostSummaryDto>
@{
    ViewData["Title"] = "Posts to review";
    var here = Context.Request.Path + Context.Request.QueryString;
}

<section class="container page">
    <header class="page-header">
        <div>
            <h1>Admin</h1>
            <p class="text-muted">
                @(Model.TotalCount == 0 ? "No posts" : Model.TotalCount == 1 ? "1 post" : $"{Model.TotalCount} posts") waiting for approval.
                Members' new posts are published only once an admin approves them.
            </p>
        </div>
    </header>

    <partial name="_AdminNav" model='"posts"' />

    @if (Model.TotalCount == 0)
    {
        <div class="empty-state"><p>All caught up: nothing is waiting for approval.</p></div>
    }
    else
    {
        <div class="manage-table-wrap">
            <table class="manage-table review-posts">
                <thead>
                    <tr>
                        <th>Post</th><th>Author</th><th>Submitted</th>
                        <th><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="review-post">
                                    @if (p.CoverUrl is not null)
                                    {
                                        <img src="@p.CoverUrl" alt="" class="activity-thumb" loading="lazy" />
                                    }
                                    <div>
                                        <a asp-controller="Blogs" asp-action="Post" asp-route-id="@p.Id"><strong>@p.Title</strong></a>
                                        @if (!string.IsNullOrEmpty(p.Excerpt))
                                        {
                                            <p class="text-muted small review-excerpt">@p.Excerpt</p>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <a asp-controller="Members" asp-action="Details" asp-route-id="@p.Author.Id" class="photo-card-owner">
                                    <partial name="_Avatar" model="p.Author" /> @p.Author.DisplayName
                                </a>
                            </td>
                            <td><time datetime="@p.UpdatedAt.ToString("o")" data-local-time="full">@p.UpdatedAt.ToString("d MMM yyyy")</time></td>
                            <td class="manage-actions">
                                <partial name="_ReviewActions" model="new ReviewActionsModel(p.Id, p.Title, here)" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="new PagerViewModel(Model.Page, Model.TotalPages)" />
    }
</section>
