@model ExplorePageViewModel
@{ var e = Model.Explore; }
@{
    ViewData["Title"] = "Explore";
}

<section class="container page">
    <header class="page-header">
        <div>
            <h1>Explore</h1>
            <p class="text-muted">What's popular on PhotoCommunity lately, and photographers you might like.</p>
        </div>
        <partial name="_SearchForm" model='""' />
    </header>

    @if (Model.PhotoOfTheDay is { } potd)
    {
        <partial name="_PhotoOfTheDay" model="potd" />
    }

    @if (e.TrendingTags.Count > 0)
    {
        <h2 class="section-heading">Trending tags</h2>
        <p class="tag-list mb-4">
            @foreach (var t in e.TrendingTags)
            {
                <a class="tag-chip" asp-controller="Photos" asp-action="Index" asp-route-tag="@t.Name">#@t.Name <span>@t.Count</span></a>
            }
        </p>
    }

    <p class="mb-4"><a class="btn btn-ghost" asp-controller="Photos" asp-action="Index" asp-route-wantsFeedback="true">Photos asking for feedback</a></p>

    @if (e.SuggestedMembers.Count > 0)
    {
        <h2 class="section-heading">Photographers to follow</h2>
        <ul class="member-results mb-4">
            @foreach (var m in e.SuggestedMembers)
            {
                <partial name="_MemberResult" model="m" />
            }
        </ul>
    }

    <h2 class="section-heading">Popular photos</h2>
    @if (e.PopularPhotos.Count == 0)
    {
        <div class="empty-state"><p>Nothing here yet: popular photos from members you don't follow show up here.</p></div>
    }
    else
    {
        <div class="photo-grid">
            @foreach (var photo in e.PopularPhotos)
            {
                <partial name="_PhotoCard" model="photo" />
            }
        </div>
    }
</section>
