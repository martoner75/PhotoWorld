<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PhotoWorld.App.ViewModels"
             xmlns:dto="clr-namespace:PhotoWorld.Shared.Photos"
             xmlns:ch="clr-namespace:PhotoWorld.Shared.Challenges"
             x:Class="PhotoWorld.App.Views.ClubPage"
             x:DataType="vm:ClubViewModel"
             Title="{Binding Title}">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="EditItem" Text="Edit" Command="{Binding EditCommand}" />
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="18,12" Spacing="10">
                <Border Padding="12,8" BackgroundColor="{DynamicResource DangerSoft}" Stroke="{DynamicResource DangerLine}"
                        IsVisible="{Binding Notice, Converter={StaticResource HasValue}}">
                    <Label Text="{Binding Notice}" FontSize="14" />
                </Border>
                <Border Padding="0" StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="160"
                        BackgroundColor="{DynamicResource PhotoBackground}"
                        IsVisible="{Binding Club.CoverDisplayUrl, Converter={StaticResource HasValue}}">
                    <Image Source="{Binding Club.CoverDisplayUrl}" Aspect="AspectFill" />
                </Border>
                <Label Text="Camera club" TextColor="{DynamicResource Accent}" Style="{StaticResource Strong}" FontSize="13" />
                <Label Text="{Binding Title}" Style="{StaticResource Heading}" />
                <Label Text="{Binding Facts}" FontSize="15" />

                <Button Text="{Binding JoinText}" Command="{Binding JoinCommand}" IsVisible="{Binding Club.CanJoin}" />
                <Button Text="Requested · withdraw" Style="{StaticResource GhostButton}" Command="{Binding LeaveCommand}" IsVisible="{Binding IsRequested}" />
                <Button Text="Member ✓ · Leave" Style="{StaticResource GhostButton}" Command="{Binding LeaveCommand}" IsVisible="{Binding IsMember}" />

                <Label Text="{Binding Club.Description}" FontSize="16"
                       IsVisible="{Binding Club.Description, Converter={StaticResource HasValue}}" />

                <VerticalStackLayout Spacing="6" IsVisible="{Binding Club.CanManageMembers}">
                    <Label Text="{Binding RequestsTitle}" Style="{StaticResource Subheading}" Margin="0,8,0,0"
                           IsVisible="{Binding HasRequests}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Requests}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClubMemberItem">
                                <Border Padding="12,8">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                        <Label Text="{Binding Name}" VerticalOptions="Center" Style="{StaticResource Strong}" />
                                        <Button Grid.Column="1" Text="Let in" Padding="12,4" CommandParameter="{Binding .}"
                                                Command="{Binding ApproveCommand, Source={RelativeSource AncestorType={x:Type vm:ClubViewModel}}, x:DataType=vm:ClubViewModel}" />
                                        <Button Grid.Column="2" Text="Turn down" Style="{StaticResource GhostButton}" Padding="12,4" CommandParameter="{Binding .}"
                                                Command="{Binding DeclineCommand, Source={RelativeSource AncestorType={x:Type vm:ClubViewModel}}, x:DataType=vm:ClubViewModel}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsActiveMember}">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Label Text="Club walks" Style="{StaticResource Subheading}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Organise" Style="{StaticResource GhostButton}" Padding="12,4" Command="{Binding OrganiseWalkCommand}" />
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Walks}" Spacing="6">
                        <BindableLayout.EmptyView>
                            <Label Text="No club walks coming up. Only members see them." Style="{StaticResource MutedText}" FontSize="14" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:WalkItem">
                                <Border Padding="12,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer CommandParameter="{Binding .}"
                                            Command="{Binding OpenWalkCommand, Source={RelativeSource AncestorType={x:Type vm:ClubViewModel}}, x:DataType=vm:ClubViewModel}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="{Binding When}" TextColor="{DynamicResource Accent}" Style="{StaticResource Strong}" FontSize="13" />
                                        <Label Text="{Binding Walk.Title}" Style="{StaticResource Strong}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsActiveMember}">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Label Text="Club workshops" Style="{StaticResource Subheading}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Host" Style="{StaticResource GhostButton}" Padding="12,4" Command="{Binding HostWorkshopCommand}" />
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Workshops}" Spacing="6">
                        <BindableLayout.EmptyView>
                            <Label Text="No club workshops coming up. Only members see them." Style="{StaticResource MutedText}" FontSize="14" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkshopItem">
                                <Border Padding="12,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer CommandParameter="{Binding .}"
                                            Command="{Binding OpenWorkshopCommand, Source={RelativeSource AncestorType={x:Type vm:ClubViewModel}}, x:DataType=vm:ClubViewModel}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="{Binding When}" TextColor="{DynamicResource Accent}" Style="{StaticResource Strong}" FontSize="13" />
                                        <Label Text="{Binding Workshop.Title}" Style="{StaticResource Strong}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Label Text="Club challenges" Style="{StaticResource Subheading}" Margin="0,8,0,0" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Challenges}" Spacing="6">
                    <BindableLayout.EmptyView>
                        <Label Text="No club challenges yet. The club's admins start them on the website." Style="{StaticResource MutedText}" FontSize="14" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="ch:ChallengeSummaryDto">
                            <Border Padding="12,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="{Binding .}"
                                        Command="{Binding OpenChallengeCommand, Source={RelativeSource AncestorType={x:Type vm:ClubViewModel}}, x:DataType=vm:ClubViewModel}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="{Binding Title}" Style="{StaticResource Strong}" />
                                    <Label Text="{Binding EntryCount, StringFormat='{0} entries'}" Style="{StaticResource MutedText}" FontSize="13" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="{Binding PhotosTitle}" Style="{StaticResource Subheading}" Margin="0,8,0,0" />
                <Label Text="{Binding ShareHint}" Style="{StaticResource MutedText}" FontSize="14"
                       IsVisible="{Binding ShareHint, Converter={StaticResource HasValue}}" />
                <FlexLayout BindableLayout.ItemsSource="{Binding Photos}" Wrap="Wrap" JustifyContent="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dto:PhotoSummaryDto">
                            <Border Padding="0" StrokeThickness="0" WidthRequest="104" HeightRequest="104" Margin="0,0,6,6"
                                    StrokeShape="RoundRectangle 8" BackgroundColor="{DynamicResource PhotoBackground}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="{Binding .}"
                                        Command="{Binding OpenPhotoCommand, Source={RelativeSource AncestorType={x:Type vm:ClubViewModel}}, x:DataType=vm:ClubViewModel}" />
                                </Border.GestureRecognizers>
                                <Image Source="{Binding ThumbnailUrl}" Aspect="AspectFill" SemanticProperties.Description="{Binding Title}" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Label Text="{Binding MembersTitle}" Style="{StaticResource Subheading}" Margin="0,8,0,0" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Members}" Spacing="6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ClubMemberItem">
                            <Border Padding="12,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="{Binding .}"
                                        Command="{Binding MemberCommand, Source={RelativeSource AncestorType={x:Type vm:ClubViewModel}}, x:DataType=vm:ClubViewModel}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Name}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Badge}" Style="{StaticResource MutedText}"
                                           IsVisible="{Binding Badge, Converter={StaticResource HasValue}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Button Text="Delete club" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" IsVisible="{Binding Club.IsOwner}"
                        Margin="0,12,0,0" />
                <Button Text="Report this club" Style="{StaticResource LinkButton}" Command="{Binding ReportCommand}"
                        IsVisible="{Binding Club.CanReport}" HorizontalOptions="Start" />
            </VerticalStackLayout>
        </ScrollView>
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center" />
    </Grid>
</ContentPage>
