@{
    ViewData["Title"] = "Privacy Policy";
}
<section class="container py-5" style="max-width: 760px">
    <h1>@ViewData["Title"]</h1>
    <p class="text-muted">
        When you sign in with Google, Facebook or Instagram, PhotoWorld receives your name, profile picture
        and (where the provider shares it) your email address. We use them only to create and identify your
        PhotoWorld account. We never post on your behalf.
    </p>
    <p class="text-muted">Replace this page with your full privacy policy before going live. Facebook and Instagram require one.</p>
</section>
