@model string
@* One of LineIcons (Shared), drawn like the Activity icon in the header: stroke in the text colour, round caps. *@
<svg class="line-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="@Model" /></svg>
